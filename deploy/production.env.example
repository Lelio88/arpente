# Variables du /opt/arpente/.env du serveur (mode 600), lues par
# deploy/docker-compose.yml et son ajout docker-compose.comptes.yml. Valeurs
# maîtresses dans le coffre .arpente-secrets/ (racine du conteneur Projets/),
# jamais dans ce dépôt.

# Socle Supabase (ANON_KEY et SERVICE_ROLE_KEY sont signées par JWT_SECRET)
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
DB_ENC_KEY=

# Brevo (compte partagé du conteneur, .brevo-secrets/brevo-smtp.env)
SMTP_USER=
SMTP_PASS=

# Service d'Arpente
SERVICE_TAG=                 # posé par deploy/deploy-service.sh (commit de l'image)
ASSISTANT_SECRET=            # ≥ 32 caractères aléatoires, distinct de JWT_SECRET
ASSISTANT_DB_PASSWORD=       # mot de passe du rôle arpente_assistant (alter role … password)
EXAMEN_ADRESSE=              # compte d'examen Google Play (les trois ensemble, ou aucun) ;
EXAMEN_CODE=                 # code fixe à 6 chiffres, donné à Google dans la Play Console ;
EXAMEN_MOT_DE_PASSE=         # ≥ 32 caractères, mot de passe GoTrue du compte, connu du seul service

# Clés publiques et secrets des fournisseurs
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# Interrupteurs de la mise en ligne (docs/mcp-architecture.md § Mise en ligne)
ANONYME_ACTIF=true
CAPTCHA_ACTIF=false
GOOGLE_ACTIF=false
OAUTH_ACTIF=false
