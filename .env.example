# Copier ce fichier en .env et renseigner les valeurs depuis
# Supabase > Project Settings > API.
NUXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# Client OAuth « Web » de Google (Google Cloud › Identifiants) ; vide = pas de bouton Google.
NUXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# false en local sans CAPTCHA ; true en production (Turnstile, page /captcha du service).
NUXT_PUBLIC_CAPTCHA=true
