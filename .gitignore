# Dépendances
node_modules/

# Nuxt
.nuxt/
.output/
dist/
# Cache de build de Nuxt Content. Le commentaire est sur SA PROPRE ligne :
# git ne reconnait pas les commentaires en fin de ligne, « .data/ # cache »
# serait un motif litteral qui ne filtre rien.
.data/

# Capacitor — projets natifs régénérés par « npx cap add »
android/
ios/

# Environnement — copie maîtresse dans .arpente-secrets/ (racine du conteneur)
.env
.env.*
!.env.example

# Certificats HTTPS de développement — contiennent des clés privées.
# Plus nécessaires par défaut depuis que devServer.https génère son certificat
# à la volée (voir nuxt.config.ts) ; la règle reste au cas où un certificat
# personnalisé serait fourni.
*.pem

# Tuiles cartographiques téléchargées (npm run download-tiles)
public/tiles/

# Réglages et état local de Claude Code (propres à la machine)
.claude/

# Artefacts de débogage Playwright MCP
.playwright-mcp/

# Notes de débogage éphémères (vidage de console, sans valeur durable)
resume.md

# Éditeurs
.idea/
.vscode/
*.sw?

# Système
.DS_Store
Thumbs.db
