{
  "name": "arpente-service",
  "private": true,
  "type": "module",
  "description": "Service d'Arpente : serveur MCP et serveur OAuth de l'assistant IA, passerelle de connexion devant GoTrue",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "contenu": "tsx scripts/compiler-contenu.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:base": "node --import tsx --test \"test/base/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.0",
    "express": "5.2.1",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
