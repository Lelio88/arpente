<?xml version="1.0" encoding="utf-8"?>
<!-- La marque et son fond degrade tiennent dans une seule couche, plein cadre.
     Elle occupe 63 % du canvas : sous les 66 % visibles apres masquage, donc
     aucun lanceur ne la rogne. Le foreground est volontairement vide. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
