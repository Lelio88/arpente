<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Liens de nos pages ouverts dans l'app (App Links) : jumelage avec
                 Agora et « Rejoindre aussi dans Arpente ». Vérifiés par
                 docs/.well-known/assetlinks.json ; sans vérification, Android
                 ouvre le navigateur et la page de repli, rien ne casse. Les
                 paramètres sont dans le fragment : plugins/liensEntrants. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="arpente.heianenterprise.com" />
                <data android:path="/jumeler.html" />
                <data android:path="/rejoindre.html" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Geolocalisation : c'est le coeur de l'app — declencher les fiches a la
         proximite d'un point d'interet et situer le visiteur sur le parcours.
         FINE et COARSE ensemble : Android 12+ laisse l'utilisateur n'accorder
         que l'approximative, et l'app reste utilisable dans ce cas. Pas de
         ACCESS_BACKGROUND_LOCATION : rien ne suit le visiteur app fermee. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Volontairement absentes :
         CAMERA          — seul le puzzle AR l'utilise, et il est desactive
                           (voir utils/features.ts).
         READ/WRITE_CALENDAR — useCalendar.ts passe par createEventWithPrompt,
                           qui delegue l'ecriture a l'agenda du systeme.
         VIBRATE         — fusionnee depuis le manifeste du plugin Haptics. -->

    <!-- Retirees du manifeste fusionne : androidx.credentials (connexion Google)
         tire androidx.biometric, qui les declare pour l'invite biometrique du
         gestionnaire d'identifiants. Arpente ne demande jamais d'empreinte. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
</manifest>
